# Copy this file to meal-bot/.env and fill in your own values.
# NONE of these are shared — they are your personal keys.

# Telegram bot token from @BotFather (https://t.me/botfather)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# Which Claude model the vision estimator uses (keep it FROZEN for a whole cut)
HEALTH_VISION_MODEL=claude-sonnet-5

# Path to the Claude Code CLI on your machine (default: "claude" on PATH)
CLAUDE_BIN=claude

# --- Optional: Apple Health ingest (weight/steps/sleep from your phone) ---
# Shared secret the Health Auto Export app sends as a Bearer token
HAE_INGEST_TOKEN=make-up-a-long-random-string
# Address to bind the ingest server to. 127.0.0.1 for local only;
# set to your Tailscale IP to receive from your phone over the tailnet.
HAE_BIND=127.0.0.1
HAE_PORT=3210
